import random

text = "I like Python I like coding I love Python"

words = text.split()
bigrams = {}

for i in range(len(words)-1):
    bigrams.setdefault(words[i], []).append(words[i+1])

word = "I"
result = [word]

for i in range(5):
    word = random.choice(bigrams[word])
    result.append(word)

print("Generated Text:", " ".join(result))
