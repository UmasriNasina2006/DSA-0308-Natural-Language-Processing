import nltk
from nltk import PCFG

grammar = PCFG.fromstring("""
S -> NP VP [1.0]
NP -> Det N [0.8] | N [0.2]
VP -> V NP [1.0]
Det -> 'the' [1.0]
N -> 'boy' [0.5] | 'ball' [0.5]
V -> 'kicks' [1.0]
""")

parser = nltk.ViterbiParser(grammar)

sentence = "the boy kicks the ball".split()

for tree in parser.parse(sentence):
    print(tree)
    print("Probability:", tree.prob())
